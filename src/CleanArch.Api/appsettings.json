{
  "ApplicationDetail": {
    "ApplicationName": "Clean Architecture",
    "Description": "Complete solution project template with clean architecture",
    "ContactWebsite": "https://amitpnk.github.io/",
    "LicenseDetail": "https://opensource.org/licenses/MIT"
  },
  "CORS": {
    "AllowAnyOrigin": false,
    "AllowedOrigins": [ "https://localhost:7200", "http://localhost:5200", "http://localhost:8081", "http://localhost:4200", "http://localhost:3000" ]
  },
  "ConnectionStrings": {
    "CleanArchConnectionString": "Data Source=(local);Initial Catalog=CleanArchDb;Integrated Security=True;Trust Server Certificate=True",
    "CleanArchIdentityConnectionString": "Data Source=(local);Initial Catalog=CleanArchDb;Integrated Security=True;Trust Server Certificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "MailSettings": {
    "Mail": "<fromemail>",
    "DisplayName": "<displayname>",
    "Password": "<yourpasswordhere>",
    "Host": "smtp.gmail.com",
    "Port": 587
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/CleanArch-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level}] {Message}{NewLine}{Exception}"
        }
      }
      //{
      //  "Name": "EmailCustom",
      //  "Args": {
      //    "fromEmail": "<fromemail>",
      //    "toEmail": "<toemail>",
      //    "enableSsl": false,
      //    "mailSubject": "<subject>",
      //    "isBodyHtml": true,
      //    "mailServer": "smtp.gmail.net",
      //    "networkCredentialuserName": "<displayname>",
      //    "networkCredentialpassword": "<yourpasswordhere>",
      //    "smtpPort": 587,
      //    "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}",
      //    "batchPostingLimit": 10,
      //    "periodMinutes": 5,
      //    "restrictedToMinimumLevel": "Verbose"
      //  }
      //}
    ],
    "Properties": {
      "Application": "Clean Architecture application"
    }
  },
  "JwtSettings": {
    "Key": "84322CFB66934ECC86D547C5CF4F2EFC",
    "Issuer": "CleanArchitectureIdentity",
    "Audience": "CleanArchitectureIdentityUser",
    "DurationInMinutes": 60
  }
}
