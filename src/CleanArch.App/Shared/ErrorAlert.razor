@if (Error is not null)
{
    <div class="alert alert-danger" role="alert">
        <div>@Error.Message</div>
        @if (Error is ApiRequestException { Errors.Count: > 0 } apiError)
        {
            <ul class="mb-0 mt-2">
                @foreach (var message in apiError.Errors)
                {
                    <li>@message</li>
                }
            </ul>
        }
    </div>
}

@code {
    /// <summary>The failure to show; nothing renders while it is null.</summary>
    [Parameter] public Exception Error { get; set; }
}
